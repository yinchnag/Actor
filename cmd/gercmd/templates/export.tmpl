{{- /*
门面函数的生成模板。用 gercmd gen -tmpl <文件> 可以换成自己的。

缩进和空行随便写——生成结果最后会过一遍 go/format，排版交给它就行。

顶层可用字段（FacadeFile）:
    .Package    输出包名，如 player
    .Recv       门面方法的接收者类型，如 PlayerEnt
    .ModType    模块类型名，如 BagMod
    .Source     模块文件名（不含路径）
    .Imports    需要的导入路径，已排序
    .Funcs      待生成的门面函数列表

每个函数可用字段与方法（FacadeFunc）:
    .Name          门面函数名，如 BagAddItem
    .Method        模块方法名，如 AddItem
    .ModType       模块类型名
    .Params        []{.Name .Type}
    .Results       []{.Var .Type .Index}
    .Doc           注释原文（每行含 //），已剔除 export: 那行

    .DocText       可直接贴在函数上方的注释块
    .HasResults    是否有返回值
    .SigParams     签名里的参数部分，如 "itemid int, count int"
    .ResultSig     签名里的返回值部分（含前导空格）
    .InvokeArgs    传给 ModInvoke 的完整实参
    .RetVars       返回语句里的变量列表，如 "r0, r1, r2"
    .NumResults    返回值个数

改模板时注意三处不能省，省了会编译不过或运行时 panic:
  1. 有返回值时零值变量必须提前声明，每条失败路径都要有东西可返回；
  2. 返回值个数校验要独立于 err —— 那是两种不同的故障；
  3. 类型断言一律用逗号 ok 形式，否则类型对不上会 panic 掉调用方协程
     （门面跑在网络/HTTP 协程上，不是 actor 协程）。
改完请跑 go test ./cmd/gercmd/ -run TestGenCompiles，它会把生成结果真编译一遍。
*/ -}}
// Code generated by gercmd from {{.Source}}; DO NOT EDIT.
// 改动请改模块方法上的 export: 标记后重新生成。

package {{.Package}}

{{if .Imports -}}
import (
{{range .Imports}}	"{{.}}"
{{end}})
{{end}}

{{- range .Funcs}}

{{.DocText -}}
func (that *{{$.Recv}}) {{.Name}}({{.SigParams}}){{.ResultSig}} {
{{- if .HasResults}}
{{range .Results}}	var {{.Var}} {{.Type}}
{{end}}	ret, err := that.GetModloader().ModInvoke({{.InvokeArgs}})
	if err != nil {
		println("{{.Name}} err:", err.Error())
		return {{.RetVars}}
	}
	if len(ret) != {{.NumResults}} {
		println("{{.Name}}: 返回值个数异常")
		return {{.RetVars}}
	}
{{range .Results}}	{{.Var}}, _ = ret[{{.Index}}].Interface().({{.Type}})
{{end}}	return {{.RetVars}}
{{- else}}
	if _, err := that.GetModloader().ModInvoke({{.InvokeArgs}}); err != nil {
		println("{{.Name}} err:", err.Error())
	}
{{- end}}
}
{{end}}
