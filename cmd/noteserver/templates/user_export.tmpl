{{- /*
每用户 actor 的门面模板（NoteMod 用）。

用法：
    gercmd gen -force -tmpl templates/user_export.tmpl -recv Hub \
        src/mods/note_mod.go src/service

与 shard_export.tmpl 的区别只有取 loader 那一步，但那一步是这份模板存在的
全部理由：每用户 actor 是**按需创建、空闲回收**的，取用必须配对
AcquireUser / ReleaseUser——inFlight 计数就是靠这一对守住"正在服务的 actor
不被回收"。漏一次 Release，那个 actor 的计数永远回不到 0，从此再也不会被
回收，一个用户漏一条协程。

原先这一对写在每个 HTTP handler 里，靠人记得写 defer。收进生成的门面之后，
它不再是"要记得做的事"，而是"想漏也漏不掉"。

模块方法本身不带 uid（一个 NoteMod 只服务一个账号，uid 构造时就定死了），
所以门面要额外接一个 uid 参数用来选 actor——签名里它排在 gid 之后。

对模块方法的约定：要么没有返回值，要么正好是 (T, error)。
违反会生成非法 Go 代码、gen 当场失败。
*/ -}}
// Code generated by gercmd from {{.Source}}; DO NOT EDIT.
// 改动请改模块方法上的 export: 标记后重新生成：go generate ./src/mods/

package {{.Package}}

{{if .Imports -}}
import (
{{range .Imports}}	"{{.}}"
{{end}})
{{end}}

{{- range .Funcs}}
{{- $fn := .}}
{{- if and .HasResults (ne .NumResults 2)}}
#此模板要求导出方法的返回值是 (T, error)，{{.ModType}}.{{.Method}} 有 {{.NumResults}} 个
{{- end}}

{{.DocText -}}
func (that *{{$.Recv}}) {{.Name}}(gid uint64, uid string{{if .SigParams}}, {{.SigParams}}{{end}}){{.ResultSig}} {
	loader := that.AcquireUser(uid)
	defer that.ReleaseUser(uid)

{{- if .HasResults}}
	out, err := loader.ModInvokeFrom(gid, {{.InvokeArgs}})
	return unwrap[{{(index .Results 0).Type}}](out, err, "{{.ModType}}.{{.Method}}")
{{- else}}
	// 无返回值 = 投递即忘。投递失败框架已经报给 DiscardedErrorHandler，
	// 这里再返回一次只会让调用方重复处理同一件事。
	_, _ = loader.ModInvokeFrom(gid, {{.InvokeArgs}})
{{- end}}
}
{{end}}
